{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "c1-add-bronze-intro",
        "language": "markdown"
      },
      "source": [
        "# Bronze Notebook — Fabric Governance (create bronze tables)",
        "",
        "Este notebook descobre artefatos (pipelines, lakehouses/items, etc.) e cria tabelas Bronze no lakehouse para uso de governança.",
        "",
        "Tabelas criadas neste notebook (exemplos):",
        "- `fabric_governance_pipelines`",
        "- `fabric_governance_dfgen2` (lakehouse / data items)",
        "- `fabric_governance_workspaces`",
        "",
        "Execute este notebook num workspace Fabric (vinculado ao repositório) — ele tentará executar `spark.sql` para criar tabelas gerenciadas no lakehouse padrão."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "c2-imports-setup",
        "language": "python"
      },
      "source": [
        "# Imports e setup",
        "import os",
        "import json",
        "from datetime import datetime",
        "import pandas as pd",
        "from pathlib import Path",
        "",
        "# Use o helper de autenticação e client se disponível no repo",
        "try:",
        "    from fabric_governance.auth import FabricAuth",
        "    from fabric_governance.api import FabricClient",
        "    has_fabric_client = True",
        "except Exception:",
        "    FabricAuth = None",
        "    FabricClient = None",
        "    has_fabric_client = False",
        "",
        "secrets_path = os.environ.get('GIT_SECRETS_PATH')",
        "workspace_id = os.environ.get('FABRIC_WORKSPACE_ID_DEV') or os.environ.get('FABRIC_WORKSPACE_ID')",
        "if not workspace_id and has_fabric_client:",
        "    raise SystemExit('Set FABRIC_WORKSPACE_ID_DEV (or FABRIC_WORKSPACE_ID) in environment or provide in secrets file')",
        "",
        "print('Fabric client available:', has_fabric_client)",
        ""
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "c3-discover-artifacts",
        "language": "python"
      },
      "source": [
        "# Discover artifacts via Fabric REST (if configured)",
        "pipelines = []",
        "items = []",
        "lakehouses = []",
        "if has_fabric_client:",
        "    auth = FabricAuth.from_env_or_file(secrets_path)",
        "    client = FabricClient(auth.get_access_token())",
        "    try:",
        "        lp = client.list_data_pipelines(workspace_id)",
        "        pipelines = lp.get('value') or lp.get('items') or lp or []",
        "    except Exception as e:",
        "        print('list_data_pipelines failed:', e)",
        "    try:",
        "        lh = client.list_lakehouses(workspace_id)",
        "        lakehouses = lh.get('value') or lh or []",
        "    except Exception as e:",
        "        print('list_lakehouses failed:', e)",
        "    try:",
        "        it = client.list_items(workspace_id)",
        "        items = it.get('value') or it or []",
        "    except Exception as e:",
        "        print('list_items failed:', e)",
        "else:",
        "    print('Fabric client not available — producing sample catalog from local config if present')",
        "",
        "print('Found:', len(pipelines), 'pipelines,', len(lakehouses), 'lakehouses,', len(items), 'items')",
        ""
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "c4-normalize-catalog",
        "language": "python"
      },
      "source": [
        "# Normalize into catalog rows for each table type",
        "rows_pipes = []",
        "for p in pipelines:",
        "    rows_pipes.append({",
        "        'id': p.get('id'),",
        "        'name': p.get('displayName') or p.get('name') or p.get('id'),",
        "        'type': p.get('type') or 'DataPipeline',",
        "        'workspace_id': workspace_id,",
        "        'raw': json.dumps(p, ensure_ascii=False),",
        "        'last_updated': p.get('lastModifiedDateTime') or p.get('modifiedDate')",
        "    })",
        "",
        "rows_lh = []",
        "for l in lakehouses:",
        "    rows_lh.append({",
        "        'id': l.get('id'),",
        "        'name': l.get('displayName') or l.get('name') or l.get('id'),",
        "        'type': 'Lakehouse',",
        "        'workspace_id': workspace_id,",
        "        'raw': json.dumps(l, ensure_ascii=False),",
        "        'last_updated': l.get('lastModifiedDateTime') or l.get('modifiedDate')",
        "    })",
        "",
        "rows_items = []",
        "for it in items:",
        "    rows_items.append({",
        "        'id': it.get('id'),",
        "        'name': it.get('displayName') or it.get('name') or it.get('id'),",
        "        'type': it.get('type') or 'Item',",
        "        'workspace_id': workspace_id,",
        "        'raw': json.dumps(it, ensure_ascii=False),",
        "        'last_updated': it.get('lastModifiedDateTime') or it.get('modifiedDate')",
        "    })",
        "",
        "df_pipes = pd.DataFrame(rows_pipes)",
        "df_lh = pd.DataFrame(rows_lh)",
        "df_items = pd.DataFrame(rows_items)",
        "",
        "print('Catalog tables prepared — rows:', len(df_pipes), len(df_lh), len(df_items))",
        ""
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "c5-create-bronze-tables",
        "language": "python"
      },
      "source": [
        "# Create Bronze tables in the default lakehouse using spark.sql if available",
        "def create_table_ddl(table_name, cols):",
        "    cols_ddl = ',\\n        '.join([f'{n} {t}' for n, t in cols])",
        "    return f'CREATE TABLE IF NOT EXISTS {table_name} (\\n{cols_ddl}\\n) USING DELTA'",
        "",
        "tables = {",
        "    'fabric_governance_pipelines': [",
        "        ('id', 'STRING'), ('name', 'STRING'), ('type', 'STRING'), ('workspace_id', 'STRING'),",
        "        ('raw', 'STRING'), ('last_updated', 'TIMESTAMP'), ('discovered_at', 'TIMESTAMP')",
        "    ],",
        "    'fabric_governance_dfgen2': [",
        "        ('id', 'STRING'), ('name', 'STRING'), ('type', 'STRING'), ('workspace_id', 'STRING'),",
        "        ('raw', 'STRING'), ('last_updated', 'TIMESTAMP'), ('discovered_at', 'TIMESTAMP')",
        "    ],",
        "    'fabric_governance_workspaces': [",
        "        ('id', 'STRING'), ('name', 'STRING'), ('tenant_id', 'STRING'), ('raw', 'STRING'), ('discovered_at', 'TIMESTAMP')",
        "    ]",
        "}",
        "",
        "# Attempt to use spark to create managed Delta tables in the default lakehouse",
        "try:",
        "    spark",
        "    using_spark = True",
        "except NameError:",
        "    using_spark = False",
        "",
        "for tname, cols in tables.items():",
        "    ddl = create_table_ddl(tname, cols)",
        "    print('DDL for', tname, ':')",
        "    print(ddl)",
        "    if using_spark:",
        "        try:",
        "            spark.sql(ddl)",
        "            print('Created table', tname)",
        "        except Exception as e:",
        "            print('Failed to create table via spark:', e)",
        "    else:",
        "        # fallback: write the DDL to sql/ folder in repo for manual execution",
        "        out_dir = Path('tools/fabric-governance/sql').resolve()",
        "        out_dir.mkdir(parents=True, exist_ok=True)",
        "        (out_dir / f'{tname}.sql').write_text(ddl, encoding='utf-8')",
        "        print('Wrote DDL to', out_dir / f'{tname}.sql')",
        "",
        "# If we have dataframes, write snapshot files to the repo catalog for inspection",
        "catalog_dir = Path('tools/fabric-governance/catalog').resolve()",
        "catalog_dir.mkdir(parents=True, exist_ok=True)",
        "if not df_pipes.empty:",
        "    (catalog_dir / 'fabric_governance_pipelines.json').write_text(df_pipes.to_json(orient='records', force_ascii=False), encoding='utf-8')",
        "if not df_lh.empty:",
        "    (catalog_dir / 'fabric_governance_dfgen2.json').write_text(df_lh.to_json(orient='records', force_ascii=False), encoding='utf-8')",
        "if not df_items.empty:",
        "    (catalog_dir / 'fabric_governance_workspaces.json').write_text(df_items.to_json(orient='records', force_ascii=False), encoding='utf-8')",
        "",
        "print('Saved catalog snapshots (JSON) to', catalog_dir)",
        ""
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "c6-next-steps",
        "language": "markdown"
      },
      "source": [
        "## Próximos passos",
        "- Verificar e rodar as queries SQL em ambiente Fabric (ou executar este notebook no workspace conectado ao repo).",
        "- Criar `nb_silver_governance.Notebook` que faça normalizações (renomear colunas, tipos, enriquecer colunas) e grave em `governance_silver.*`.",
        "- Criar `nb_gold_governance.Notebook` que faça limpar, deduplicar e aplicar regras de negócio, preparando o modelo semântico.",
        "- Commit e push das alterações para a branch `dev` (mapear para DEV workspace no Fabric)."
      ]
    }
  ]
}
